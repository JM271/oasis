rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Photos are small base64 JPEGs stored inside the document.
    function validPhoto(photo) {
      return photo is string && photo.size() <= 300000;
    }

    function validProfile(profile) {
      return profile.keys().hasAll(['name', 'vehicle', 'phone', 'about', 'photo'])
        && validPhoto(profile.photo)
        && profile.name is string
        && profile.name.size() > 0 && profile.name.size() <= 60
        && profile.vehicle is string
        && profile.vehicle.size() > 0 && profile.vehicle.size() <= 80
        && profile.phone is string && profile.phone.size() <= 30
        && profile.about is string && profile.about.size() <= 300;
    }

    // Profiles are private; hosts see the copy attached to each request.
    match /profiles/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'vehicle', 'phone', 'about', 'photo', 'updatedAt'
        ])
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt is timestamp;
    }

    // Push addresses of a user's devices; read only by the notify function.
    match /devices/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens', 'language', 'updatedAt'])
        && (!('language' in request.resource.data)
          || request.resource.data.language in ['en', 'de', 'fr'])
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 10
        && request.resource.data.updatedAt is timestamp;
    }

    function validPlaceExtras(place) {
      return validPhoto(place.photo)
        && place.vehicles is list
        && place.vehicles.size() <= 4
        && place.vehicles.hasOnly(['campervan', 'motorhome', 'large', 'trailer'])
        && place.services is list
        && place.services.size() <= 9
        && place.services.hasOnly(['farmShop', 'shop', 'food', 'fuel',
                                   'campsite', 'dump', 'blackWater',
                                   'electricity', 'repairs'])
        && place.businessInfo is string && place.businessInfo.size() <= 500
        && place.website is string && place.website.size() <= 200
        && (place.website == '' || place.website.matches('https?://.+'))
        // Optional, as places saved by older app versions lack them.
        && (!('hose' in place) || place.hose is bool)
        && (!('selfService' in place) || place.selfService is bool)
        && (!('payments' in place)
            || (place.payments is list
                && place.payments.size() <= 2
                && place.payments.hasOnly(['twint', 'cash'])));
    }

    function activePlace(placeId) {
      return exists(/databases/$(database)/documents/waterPlaces/$(placeId))
        && get(/databases/$(database)/documents/waterPlaces/$(placeId)).data.isActive == true;
    }

    // A place hidden after travelers' reports; written only by the
    // hideReportedPlace function and removed once the place was checked.
    function suspended(placeId) {
      return exists(/databases/$(database)/documents/suspensions/$(placeId));
    }

    // Each user's favorite water places, private to them.
    match /favorites/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['placeIds', 'updatedAt'])
        && request.resource.data.placeIds is list
        && request.resource.data.placeIds.size() <= 200
        && request.resource.data.updatedAt is timestamp;
    }

    // Travelers report a listed place once each, never their own; nobody
    // reads reports in the app.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'placeId', 'reporterUid', 'reason', 'createdAt'
        ])
        && request.resource.data.placeId is string
        && reportId == request.resource.data.placeId + '_' + request.auth.uid
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['noWater', 'doesNotExist', 'wrongLocation']
        && request.resource.data.createdAt is timestamp
        && activePlace(request.resource.data.placeId)
        && get(/databases/$(database)/documents/waterPlaces/$(request.resource.data.placeId)).data.ownerUid
          != request.auth.uid;
    }

    match /waterPlaces/{placeId} {
      allow read: if resource.data.isActive == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // One place per account: the document ID is the owner's UID.
      allow create: if signedIn()
        && placeId == request.auth.uid
        && !suspended(placeId)
        && request.resource.data.keys().hasOnly([
          'name', 'area', 'host', 'private', 'price', 'description',
          'openingTimes', 'latitude', 'longitude', 'photo', 'vehicles',
          'services', 'businessInfo', 'website', 'hose', 'selfService',
          'payments', 'ownerUid', 'isActive', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'area', 'host', 'private', 'price', 'description',
          'openingTimes', 'latitude', 'longitude', 'photo', 'vehicles',
          'services', 'businessInfo', 'website',
          'ownerUid', 'isActive', 'createdAt', 'updatedAt'
        ])
        && validPlaceExtras(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isActive == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.name is string
        && request.resource.data.area is string
        && request.resource.data.host is string
        && request.resource.data.price is string
        && request.resource.data.description is string
        && request.resource.data.openingTimes is string
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.private is bool;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && !suspended(placeId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.isActive is bool
        && validPlaceExtras(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'area', 'host', 'private', 'price', 'description',
                    'openingTimes', 'latitude', 'longitude', 'photo',
                    'vehicles', 'services', 'businessInfo', 'website',
                    'hose', 'selfService', 'payments', 'isActive',
                    'updatedAt']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /refillRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'placeId', 'placeName', 'hostUid', 'requesterUid', 'liters',
          'message', 'requester', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'placeId', 'placeName', 'hostUid', 'requesterUid', 'liters',
          'message', 'requester', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.requester is map
        && request.resource.data.requester.keys().hasOnly([
          'name', 'vehicle', 'phone', 'about', 'photo'
        ])
        && validProfile(request.resource.data.requester)
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.hostUid is string
        && request.resource.data.placeId is string
        && activePlace(request.resource.data.placeId)
        && get(/databases/$(database)/documents/waterPlaces/$(request.resource.data.placeId)).data.ownerUid
          == request.resource.data.hostUid
        && request.resource.data.liters is int
        && request.resource.data.liters > 0
        && request.resource.data.placeName is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.hostUid == request.auth.uid);
      // Hosts answer pending requests and can delete requests from their
      // list; a pending request is declined when deleted.
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.get('hostHidden', false) is bool
        && ((resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'hostHidden', 'updatedAt']))
          || (resource.data.status != 'pending'
            && request.resource.data.hostHidden == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['hostHidden', 'updatedAt'])));
      // Water takers can delete requests from their list; a pending request
      // is cancelled when deleted.
      allow update: if signedIn()
        && resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterHidden == true
        && ((resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'requesterHidden', 'updatedAt']))
          || (resource.data.status != 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['requesterHidden', 'updatedAt'])));
      // Water takers announce their arrival once, while the request is
      // pending or accepted; the host then gets a notification.
      allow update: if signedIn()
        && resource.data.requesterUid == request.auth.uid
        && resource.data.status in ['pending', 'accepted']
        && !('arrivedAt' in resource.data)
        && request.resource.data.arrivedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['arrivedAt', 'updatedAt']);
      allow delete: if false;
    }
  }
}
